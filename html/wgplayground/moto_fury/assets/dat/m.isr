        <string id="INSTRUCTIONS_RULES_TEXT" index="38">
            <en>RIDE AS LONG AND FAST AS YOU CAN WITHOUT CRASHING. OVERTAKE CARS CLOSELY AT HIGH SPEEDS TO GAIN EXTRA POINTS AND CASH. RIDING IN THE OPPOSITE DIRECTION ALSO GIVES MORE POINTS AND CASH. GET THE HIGHEST SCORE.</en>
            <ru>ВЫ ДОЛЖНЫ ЕХАТЬ КАК МОЖНО ДОЛЬШЕ И БЫСТРЕЕ БЕЗ СТОЛКНОВЕНИЙ. ВЫБЕРИТЕ САМЫЙ БЫСТРЫЙ МОТОЦИКЛ И ЕДЬТЕ НА МАКСИМАЛЬНОЙ СКОРОСТИ, ЧТОБЫ ПОЛУЧИТЬ ДОПОЛНИТЕЛЬНЫЕ ОЧКИ И НАЛИЧНЫЕ. ЕЗДА ПО ВСТРЕЧНОЙ ПОЛЕСЕ ТАКЖЕ ПРИНОСИТ БОЛЬШЕ ОЧКОВ И НАЛИЧНЫХ. ПОЛУЧИТЕ КАК МОЖНО БОЛЬШЕ ОЧКОВ.</ru>
            <es>CONDUCE A LA MAYOR VELOCIDAD Y DURANTE EL MAYOR TIEMPO QUE PUEDAS SIN CHOCARTE. ADELANTA A LOS DEMÁS COCHES A GRAN VELOCIDAD PASANDO MUY CERCA DE ELLOS Y CONSEGUIRÁS MÁS DINERO Y PUNTOS. EN EL MODO DE DOBLE SENTIDO, OBTENDRÁS MÁS DINERO Y PUNTOS. ¡CONSIGUE LA MEJOR PUNTUACIÓN!</es>
            <de>FAHR SO LANG UND SCHNELL DU KANNST, OHNE EINEN UNFALL ZU BAUEN. STARTE ENGE ÜBERHOLMANÖVER IN HÖCHST- GESCHWINDIGKEIT, UM DIR ZUSÄTZLICHE PUNKTE UND NOCH MEHR GELD ZU VERDIENEN. WENN DU IM MODUS MIT GEGENVERKEHR ALS GEISTERFAHRER UNTERWEGS BIST, BRINGT DIR DAS DAS MEHR PUNKTE UND GELD. HOL DIR IN DER BESTENLISTE DEN HIGHSCORE.</de>
            <it>GUIDA IL PIÙ A LUNGO E PIÙ VELOCEMENTE POSSIBILE SENZA SCHIANTARTI. SORPASSA LE AUTO DA VICINO AD ALTA VELOCITÀ PER GUADAGNARE DENARO E PUNTI EXTRA. GUIDANDO NELLA DIREZIONE OPPOSTA RICEVI ANCHE PIÙ PUNTI E PIÙ SOLDI. OTTIENI IL PUNTEGGIO PIÙ ALTO!</it>
            <fr>CONDUISEZ AUSSI LOIN ET AUSSI VITE QUE VOUS LE POUVEZ SANS AVOIR D'ACCIDENT. DOUBLEZ LES VOITURES DE JUSTESSE EN ROULANT TRÈS VITE POUR GAGNER DES POINTS SUPPLÉMENTAIRES ET DE L'ARGENT. CONDUISEZ ÉGALEMENT EN SENS INVERSE POUR GAGNER ENCORE PLUS DE POINTS ET D'ARGENT. OBTENEZ LE MEILLEUR SCORE.</fr>
            <br>DIRIJA O MÁXIMO QUE PUDER E RÁPIDO SEM COLIDIR. ULTRAPASSE CARROS BEM PRÓXIMOS EM VELOCIDADE ALTA PARA GANHAR PONTOS E DINHEIRO EXTRAS. DIRIGINDO NA DIREÇÃO OPOSTA NO MODO BIDIRECIONAL TAMBÉM DÁ MAIS PONTOS E DINHEIRO. OBTENHA A MAIOR PONTUAÇÃO NAS TABELAS DE CLASSIFICAÇÃO.</br>
            <nl>RIJD ZO VER EN ZO HARD ALS JE KAN ZONDER TE VERONGELUKKEN. RIJD VLAK LANGS ANDERE AUTO'S OM ZE IN TE HALEN EN VERDIEN ZO EXTRA PUNTEN EN GELD. AAN DE VERKEERDE KANT RIJDEN LEVERT OOK MEER PUNTEN EN GELD OP. PROBEER EEN TOPSCORE TE BEHALEN.</nl>
            <no>KJØR SÅ LENGE OG RASKT SOM MULIG UTEN Å KRASJE. KJØR FORBI BILER TETT OG I HØYE HASTIGHETER FOR Å FÅ EKSTRA POENG OG KONTANTER. Å KJØRE I MOTSATT RETNING GIR OGSÅ FLERE POENG OG PENGER. FÅ DEN HØYESTE POENGSUMMEN.</no>
        </string>
        <string id="INSTRUCTIONS_CONTROLS_TEXT" index="39">
            <en>CONTROLS:\n\nTOUCH BRAKE ICON TO SLOW DOWN.\n\nTAP DIRECTIONAL ARROWS TO STEER THE CAR.</en>
            <ru>ОРГАНЫ УПРАВЛЕНИЯ:\n\n НАЖМИТЕ НА ЗНАЧЕК ТОРМОЗА, ЧТОБЫ ЗАМЕДЛИТЬСЯ. \n\n С ПОМОЩЬЮ СТРЕЛОК НАПРАВЛЕНИЯ, ВЫ МОЖЕТЕ УПРАВЛЯТЬ АВТОМОБИЛЕМ.</ru>
            <sk>controls touch</sk>
            <es>CONTROLES:\n\nTOCA EL ICONO DEL FRENO PARA FRENAR.\n\nTOCA LAS FLECHAS DE DIRECCIÓN PARA DIRIGIR EL COCHE HACIA LOS LADOS.</es>
            <de>STEUERUNG:\n\nZUM ABBREMSEN BREMS-SYMBOL BERÜHREN.\n\nZUM STEUERN DES WAGENS DIE RICHTUNGSTASTEN ANTIPPEN.</de>
            <it>COMANDI:\n\nTOCCA L'ICONA DEI FRENI PER RALLENTARE.\n\nTOCCA LE FRECCE DIREZIONALI PER STERZARE.</it>
            <fr>COMMANDES:\n\nTOUCHEZ L'ICÔNE FREIN POUR RALENTIR.\n\nTOUCHEZ LES FLÈCHES DIRECTIONNELLES À GAUCHE OU À DROITE POUR FAIRE TOURNER LA VOITURE.</fr>
            <br>CONTROLES:\n\nTOQUE NO ÍCONE DA FREIO PARA DESACELERAR.\n\nTOQUE NAS SETAS DIRECIONAIS PARA DIRIGIR O CARRO.</br>
            <nl>BESTURING:\n\nTIK HET REM ICOONTJE AAN OM AF TE REMMEN.\n\nTIK DE PIJLTJES AAN OM TE STUREN.</nl>
            <no>KONTROLLER:\n\n RØR BREMSEIKONET FOR Å BREMSE.\n\n TRYKK PÅ RETNINGSPILER FOR Å STYRE BILEN.</no>
        </string>
        <string id="INSTRUCTIONS_CONTROLS_DESKTOP_TEXT" index="40">
            <en>CONTROLS:\n\n8 OR NAVIGATION KEY DOWN - BRAKE\n\n4 OR NAVIGATION KEY LEFT - STEER LEFT\n\n6 OR NAVIGATION KEY RIGHT - STEER RIGHT</en>
            <ru></ru>
            <sk>controls keyboard</sk>
            <es>CONTROLES:\n\n8 O BOTÓN DE NAVEGACIÓN HACIA ABAJO - FRENAR\n\n4 O BOTÓN DE NAVEGACIÓN HACIA LA IZQUIERDA - DESPLAZARSE HACIA LA IZQUIERDA\n\n6 O BOTÓN DE NAVEGACIÓN HACIA LA DERECHA - DESPLAZARSE HACIA LA DERECHA</es>
            <de>STEUERUNG:\n\n8 ODER NAVIGATIONSTASTE NACH UNTEN - BREMSEN\n\n4 ODER NAVIGATIONSTASTE NACH LINKS - NACH LINKS FAHREN\n\n6 ODER NAVIGATIONSTASTE NACH RECHTS - NACH RECHTS FAHREN</de>
            <it>COMANDI:\n\n8 O TASTO DI NAVIGAZIONE GIÙ - FRENA\n\n4 O TASTO DI NAVIGAZIONE SINISTRO - STERZA A SINISTRA\n\n6 O TASTO DI NAVIGAZIONE DESTRO - STERZA A DESTRA</it>
            <fr>COMMANDES:\n\n8 OU TOUCHE DE NAVIGATION BASSE - FREINER\n\n4 OU TOUCHE DE NAVIGATION GAUCHE - TOURNER À GAUCHE\n\n6 OU TOUCHE DE NAVIGATION DROITE - TOURNER À DROITE</fr>
            <br>CONTROLES:\n\n8 OU TECLA DE NAVEGAÇÃO PARA BAIXO - FREIO\n\n4 OU TECLA DE NAVEGAÇÃO ESQUERDA - DIRIGIR PARA A ESQUERDA\n\n6 OU TECLA DE NAVEGAÇÃO DIREITA - DIRIGIR PARA A DIREITA</br>
            <nl>BESTURING:\n\n8 OF NAVIGATIE KEY DOWN - REM\n\n4 OF NAVIGATIEKNOP LINKS - LINKS STERKER\n\n6 OF NAVIGATIESLEUTOORRECHT - RECHTS VAN DE STEER</nl>
            <no>KONTROLLER:\n\n8 ELLER NAVIGASJONS-TASTEN NED - BREMS\n\n4 ELLER NAVIGASJONS-TASTEN VENSTRE - SVING TIL VENSTRE\n\n6 ELLER NAVIGASJONS-TASTEN HØYRE - SVING TIL HØYRE</no>
        </string>

