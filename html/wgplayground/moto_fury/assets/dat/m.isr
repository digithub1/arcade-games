        <string id="HIGH_SCORE" index="36">
            <en>HIGH SCORE</en>
            <es>RÉCORD DE PUNTUACIÓN</es>
            <de>HIGHSCORE</de>
            <it>PUNTEGGIO ALTO</it>
            <fr>MEILLEUR SCORE</fr>
