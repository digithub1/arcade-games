[project]
title = Mind Games - Math Crosswords
version = 1.3.2
publisher = Rad Foundry
developer = Rad Foundry
write_log = 0
write_log_file = 0
minimum_log_level = 3
compress_archive = 1
custom_resources = /resources
bundle_resources = /bundle
platform_name = gamepush
title_as_file_name = MindGamesMathCrosswords

[display]
width = 900
height = 1600
high_dpi = 1
samples = 0
fullscreen = 0
display_profiles = /builtins/render/default.display_profilesc
dynamic_orientation = 0
update_frequency = 0
swap_interval = 1
vsync = 1
variable_dt = 0
display_device_info = 0

[render]
clear_color_red = 0.922
clear_color_green = 0.961
clear_color_blue = 0.886
clear_color_alpha = 1

[physics]
max_collision_object_count = 128
type = 2D
use_fixed_timestep = 0
debug = 0
debug_alpha = 0.9
debug_scale = 30
world_count = 4
gravity_x = 0
gravity_y = -10
gravity_z = 0
scale = 0.01
allow_dynamic_transforms = 1
max_collisions = 64
max_contacts = 128
contact_impulse_limit = 0
ray_cast_limit_2d = 64
ray_cast_limit_3d = 128
trigger_overlap_capacity = 16
velocity_threshold = 1
max_fixed_timesteps = 2

[box2d]
velocity_iterations = 10
position_iterations = 10
sub_step_count = 4

[bootstrap]
main_collection = /assets/scenes/loader.collectionc
render = /game/system/game.renderc
debug_init_script = 

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
max_draw_calls = 512
max_characters = 8192
max_font_batches = 128
max_debug_vertices = 10000
texture_profiles = /eva/system/eva.texture_profiles
verify_graphics_calls = 1
opengl_version_hint = 33
opengl_core_profile_hint = 1
memory_size = 512

[shader]
output_spirv = 0

[sound]
gain = 1
use_linear_gain = 1
max_sound_data = 128
max_sound_buffers = 32
max_sound_sources = 16
max_sound_instances = 256
max_component_count = 32
sample_frame_count = 0
use_thread = 1
stream_enabled = 0
stream_chunk_size = 16384
stream_preload_size = 16384
stream_cache_size = 2097152

[resource]
http_cache = 0
max_resources = 1024

[input]
repeat_delay = 0.5
repeat_interval = 0.2
gamepads = /builtins/input/default.gamepadsc
game_binding = /builtins/input/all.input_bindingc
use_accelerometer = 0

[sprite]
max_count = 256
subpixels = 1

[model]
max_count = 0
split_meshes = 0
max_bone_matrix_texture_width = 1024
max_bone_matrix_texture_height = 1024

[mesh]
max_count = 0

[gui]
max_count = 32
max_animation_count = 1024
max_particle_count = 1024
max_particlefx_count = 16

[collection]
max_instances = 256
max_input_stack_entries = 16

[collection_proxy]
max_count = 16

[collectionfactory]
max_count = 128

[factory]
max_count = 128

